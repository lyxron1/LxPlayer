# ==========================================
# LxPlayer PC - Environment Configuration
# ==========================================
# Bu dosya örnek yapılandırma şablonudur.
# Projeyi çalıştırırken kendi ayarlarınızı tanımlamak isterseniz,
# bu dosyayı `.env` olarak kopyalayabilir veya uygulama arayüzündeki
# "Profil Ekle" ekranını kullanarak bilgilerinizi girebilirsiniz.

# Uygulama Çalışma Modu ('development' | 'production')
NODE_ENV=development

# Vite Geliştirici Sunucusu Portu
VITE_DEV_PORT=5173

# Opsiyonel: Varsayılan IPTV / Xtream Codes Sunucu Bilgileri (Test için)
# VITE_DEFAULT_SERVER_URL=http://your-iptv-server.com:8080
# VITE_DEFAULT_USERNAME=your_username
# VITE_DEFAULT_PASSWORD=your_password

# Donanım Hızlandırma Desteği ('true' | 'false')
VITE_ENABLE_HW_ACCELERATION=true

# Varsayılan Kullanıcı Ajanı (User-Agent)
VITE_DEFAULT_USER_AGENT=IPTVSmartersPro/3.1.5 (Linux; Android 11)
