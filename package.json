{
  "name": "lxplayer",
  "version": "2.4.0",
  "description": "LxPlayer Pro IPTV & Media Center Desktop",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "concurrently \"vite\" \"electron .\"",
    "electron": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir",
    "dist:portable": "vite build && electron-builder --win portable"
  },
  "keywords": [
    "iptv",
    "player",
    "electron",
    "react",
    "vite",
    "desktop"
  ],
  "author": "LxPlayer Team",
  "license": "MIT",
  "dependencies": {
    "hls.js": "^1.5.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.lxplayer.desktop",
    "productName": "LxPlayer",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/logo1.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LxPlayer"
    }
  }
}
